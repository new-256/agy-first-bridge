{
  "name": "agy-indicator",
  "description": "agy 状态灯（家级）：收集各会话 agy-first-bridge 推送的 agy 运行状态，经 webServer HTTP 路由暴露给浏览器，在会话标题栏按项目（工作目录）分别显示状态灯。随软件启动、所有会话自动可见。标准 npm 分发形态：host 半用裸包名（main → lib/index.mjs），client 半靠 dsh.client 声明自动纳入浏览器。",
  "version": "1.5.15",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "cordis",
    "agy",
    "status-light",
    "indicator",
    "deepseek-harness"
  ],
  "license": "MIT"
}